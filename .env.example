# Supabase project "Trucking" → Project Settings → API (database and logins)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# On Cloudflare Workers: the two NEXT_PUBLIC_ values are build variables, and the
# R2_ values are Worker secrets (README → Hosting). Locally for `pnpm cf:preview`,
# put the R2_ values in .dev.vars.

# Cloudflare R2 (receipt photos and document scans). Server-only secrets:
# never rename these with a NEXT_PUBLIC_ prefix, or they would reach browsers.
# Cloudflare dashboard → R2 → overview page (Account ID) and Manage API tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=trucking-files
# Leave empty for Cloudflare. Only for a local S3-compatible test server, e.g. MinIO:
# R2_ENDPOINT=http://127.0.0.1:9000
R2_ENDPOINT=

# JoFotara (نظام الفوترة الوطني الإلكتروني), to send invoices to the Income and
# Sales Tax Department. Server-only secrets from the JoFotara portal (ربط
# الأنظمة): Client ID and Secret Key. On Cloudflare, set them as Worker secrets.
# Leave empty until the company is ready to send real invoices.
JOFOTARA_CLIENT_ID=
JOFOTARA_SECRET_KEY=
# Only to point at another address; the default is the live system.
# JOFOTARA_URL=https://backend.jofotara.gov.jo/core/invoices/
